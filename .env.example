# 플랫폼 설정
PLATFORM=kakao
# 사용 가능한 값: kakao, discord

# 카카오톡 설정
KAKAO_API_KEY=your_kakao_api_key_here
KAKAO_WEBHOOK_URL=http://localhost:5000/webhook

# 디스코드 설정
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_COMMAND_PREFIX=!

# 시스템 설정
DATA_FILE=data.db
INITIAL_POINTS=100

# 게임 설정
NUMBER_GUESS_ENTRY_COST=10
NUMBER_GUESS_BASE_REWARD=50
NUMBER_GUESS_BONUS_PER_ATTEMPT=5
NUMBER_GUESS_CONSOLATION=5

RPS_WIN_REWARD=10
RPS_LOSE_COST=5

# 서버 설정 (카카오톡 웹훅용)
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=bot.log

# 게임 설정 - 강화
# 게임 설정 - 강화
ENHANCEMENT_MAX_LEVEL=15
ENHANCEMENT_BASE_COST=40
ENHANCEMENT_COST_MULTIPLIER=1.4
ENHANCEMENT_SELL_MULTIPLIER=0.6
ENHANCEMENT_LEVEL_BONUS=40
